# Python environment / bytecode
.venv/
venv/
__pycache__/
*.py[cod]

# Editor
.vscode/

# --- Derived data -----------------------------------------------------------
# Figures ARE tracked: *.png is the output of record for this comparison.
# These two are not, and the trade-off is worth stating explicitly:
#
# detections.npz   -- per-detector spike times for the current window. Rewritten by
#                     every compare_spikes.py run, so it would churn the history.
#                     Regenerate it; evaluate_detectors.py / spike_statistics.py
#                     read only this file.
detections.npz
#
# .delphos_cache/  -- memoised Delphos CLI output, ~5 min per entry. NOTE these are
#                     NOT bit-reproducible: Delphos tiles internally based on free
#                     RAM, so re-running the same parameters gives ~2-15% different
#                     counts (see Delphos.md). Ignoring it means those exact
#                     detections cannot be recreated. Track it deliberately if a
#                     specific run needs to be preserved alongside its figures.
.delphos_cache/
#
# sim_data/       -- synthetic EDFs, ~38 MB each x 6 SNR levels. Fully regenerable and BIT
#                    REPRODUCIBLE (unlike Delphos): `python sim_data.py` rebuilds them, and the
#                    generator config is hashed into every filename, so a rebuilt file with the
#                    same name IS the same data. The .truth.npz sidecars live here too and go
#                    with them -- the ground truth is also copied into every sim_runs/*.npz,
#                    which IS tracked, so nothing needed for scoring is lost.
sim_data/
#
# prep_edf/       -- the post-montage, median-filtered, decimated EDFs written so Delphos can
#                    read the same signal as the other two arms. Hundreds of MB, and fully
#                    regenerable: the filename carries rec_id, med_kernel, rate and span, so a
#                    rebuilt file with the same name IS the same data (unlike .delphos_cache,
#                    which is not bit-reproducible and is ignored for the opposite reason).
prep_edf/
#
# sim_runs/*.npz is deliberately NOT ignored: one file per (SNR, operating point), ~150 kB,
# written once rather than on every run, and the only record of Delphos detections that cannot
# be reproduced bit-for-bit. Same reasoning as the .delphos_cache note above, opposite call --
# these are small and stable enough to keep.

# Delphos also drops these next to the input when output_dir is reused by hand
*_delphos.mat
*_delphos.mrk
*_rate.xlsx
*_crossrates_with_spikes.xlsx
*_coocrates_with_spikes.xlsx
